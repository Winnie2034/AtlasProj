{
  "name": "@atlas/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:security": "tsx src/utils/security.selfcheck.ts",
    "check:tenant": "tsx src/repositories/tenantIsolation.selfcheck.ts",
