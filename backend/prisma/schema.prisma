generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                     @id @default(uuid())
  email            String?                    @unique
  passwordHash     String?                    @map("password_hash")
  displayName      String?                    @map("display_name")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  sessions         Session[]
  hevyConnection   HevyConnection?
  workouts         Workout[]
  templateMetadata ExerciseTemplateMetadata[]
  syncHistory      SyncHistory[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model HevyConnection {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyCiphertext         String   @map("api_key_ciphertext")
  apiKeyIv                 String   @map("api_key_iv")
  apiKeyTag                String   @map("api_key_tag")
  status                   String   @default("connected")
  lastSuccessfulSyncCursor String?  @map("last_successful_sync_cursor")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("hevy_connections")
}

model Workout {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hevyId        String     @map("hevy_id")
  title         String
  description   String?
  startTime     DateTime   @map("start_time")
  endTime       DateTime   @map("end_time")
  hevyCreatedAt DateTime   @map("hevy_created_at")
  hevyUpdatedAt DateTime   @map("hevy_updated_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  exercises     Exercise[]

  @@unique([userId, hevyId])
  @@index([userId, startTime])
  @@index([userId, title])
  @@map("workouts")
}

model Exercise {
  id                     String   @id @default(uuid())
  workoutId              String   @map("workout_id")
  workout                Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  hevyExerciseTemplateId String   @map("hevy_exercise_template_id")
  title                  String
  notes                  String?
  exerciseIndex          Int      @map("exercise_index")
  supersetId             Int?     @map("superset_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  sets                   Set[]

  @@index([workoutId])
  @@index([hevyExerciseTemplateId])
  @@map("exercises")
}

model ExerciseTemplateMetadata {
  id                     String   @id @default(uuid())
  userId                 String   @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hevyExerciseTemplateId String   @map("hevy_exercise_template_id")
  title                  String
  type                   String?
  primaryMuscleGroup     String?  @map("primary_muscle_group")
  secondaryMuscleGroups  String[] @default([]) @map("secondary_muscle_groups")
  equipment              String?
  isCustom               Boolean  @default(false) @map("is_custom")
  fetchedAt              DateTime @default(now()) @map("fetched_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([userId, hevyExerciseTemplateId], map: "metadata_user_template_key")
  @@index([userId, primaryMuscleGroup], map: "metadata_user_primary_muscle_idx")
  @@map("exercise_template_metadata")
}

model Set {
  id              String   @id @default(uuid())
  exerciseId      String   @map("exercise_id")
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setIndex        Int      @map("set_index")
  setType         String   @map("set_type")
  weightKg        Decimal? @map("weight_kg") @db.Decimal(6, 2)
  reps            Int?
  distanceMeters  Decimal? @map("distance_meters") @db.Decimal(8, 2)
  durationSeconds Int?     @map("duration_seconds")
  rpe             Decimal? @db.Decimal(3, 1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([exerciseId])
  @@map("sets")
}

model SyncHistory {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime  @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  status          String
  workoutsFetched Int       @default(0) @map("workouts_fetched")
  workoutsCreated Int       @default(0) @map("workouts_created")
  workoutsUpdated Int       @default(0) @map("workouts_updated")
  workoutsDeleted Int       @default(0) @map("workouts_deleted")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, startedAt])
  @@map("sync_history")
}
